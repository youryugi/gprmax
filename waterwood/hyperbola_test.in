#title: Optimized GPR hyperbola detection
#domain: 2.5 0.6 0.3
#dx_dy_dz: 0.01 0.01 0.01
#time_window: 1e-7

#material: 1 0 1 0 air
#material: 6 0.001 1 0 sandy_soil
#material: 25 0.05 1 0 metal_target

#waveform: ricker 1 4e8 pulse

#box: 0 0 0 2.5 0.6 0.05 air
#box: 0 0 0.05 2.5 0.6 0.3 sandy_soil

#hertzian_dipole: z 0.05 0.3 0.02 pulse
#rx: 0.05 0.3 0.02
#src_steps: 0.025 0 0
#rx_steps: 0.025 0 0

#cylinder: 1.25 0.3 0.12 1.25 0.3 0.15 0.04 metal_target