#title: Realistic near-surface GPR B-scan over a buried metal sphere

#domain: 5.0 1 0.004

#dx_dy_dz: 0.003 0.003 0.003

#time_window: 20e-9

#material: 1      0       1 0 air
#material: 6   0.005      1 0 soil
#material: 80   0.5      1 0 water
#material: 3   0.0002     1 0 wood_dry   

#waveform: ricker 1 4.0e8 my_ricker
#hertzian_dipole: z 0.30 0.1 0 my_ricker
#rx: 0.30 0.1 0
#src_steps: 0.01 0 0
#rx_steps:  0.01 0 0

#box: 0 0.00 0.00  5.0 0.3 0.004 water
#box: 0 0.3 0.00  5.0 1 0.004 water


#box: 2.44 0.46 0.000   2.56 0.54 0.004 wood_dry
##sphere: 2.50 0.5 0.000 0.02 pec
##sphere: 3 0.7 0.000 0.02 pec
## 运行提示:
##  总步数估计: 扫描有效长度 (例如 0.20m → 4.80m ≈ 4.6m) / 0.02m ≈ 230
##  命令示例: python -m gprMax t1003/test8.in -n 230
##  若用多GPU拆分脚本请把 --runs 设为 230